# MongoDB Atlas
MONGODB_URI="mongodb+srv://usuario:senha@cluster.mongodb.net/"
MONGODB_DB="DarkAumigos"

# PostgreSQL / Supabase
POSTGRES_HOST="db.seu-projeto.supabase.co"
POSTGRES_PORT="5432"
POSTGRES_DB="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="sua_senha"
POSTGRES_SSLMODE="require"

# Saída padrão
OUTPUT_SQL="carga_oracle.sql"

# Oracle (opcional) - usado quando passar `--load-oracle` na CLI
# Você pode informar ORACLE_DSN diretamente ou construir com host/port/service
ORACLE_USER="usuario_oracle"
ORACLE_PASSWORD="senha_oracle"
# Exemplo de DSN: host:port/service
ORACLE_DSN="dbhost:1521/ORCLPDB1"
# ou defina separadamente:
ORACLE_HOST="dbhost"
ORACLE_PORT="1521"
ORACLE_SERVICE="ORCLPDB1"
